# Откуда начинать обход (первая страница каталога)
START_URL=https://books.toscrape.com/catalogue/page-1.html
# Сколько страниц списка обходить, 0 — все
MAX_PAGES=0
# Потоков для карточек товаров и пауза между запросами одного потока, сек
WORKERS=8
DELAY=0.2

# Относительные пути — от папки проекта
DB_PATH=data/pricewatch.db
EXCEL_PATH=out/products.xlsx

# Уведомления в Telegram: токен бота от @BotFather и id чата (необязательно)
TG_TOKEN=
TG_CHAT_ID=

# Google Таблица (необязательно): id из адреса таблицы и путь к ключу сервисного аккаунта
GSHEET_ID=
GOOGLE_CREDENTIALS=
